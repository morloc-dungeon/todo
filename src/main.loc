--' A TODO list manager written as a functional core with one IO shell
--'
--' Every command is `edit f <a pure [Todo] -> [Todo] function>`. The
--' only IO in the module is inside `edit`; everything else is a pure
--' list transformation that can be read, tested and composed on its own.
module demo-todo (add, check, drop, clean, sort, list)

import root-py

--' Path to the TODO file
--' @default "todo.json"
--' @arg -F/--file
type TodoFile = Str

record Todo where
  --' item title
  title :: Str
  --' priority, 1 (low) to 3 (high)
  priority :: Int
  --' whether the task is complete
  done :: Bool

record py => Todo = "dict"


-- ---------------------------------------------------------------- IO shell

--' Read a JSON file, or `dflt` if it is not there.
--'
--\ Fully polymorphic: `a` is fixed by the call site. This is the whole
--\ persistence layer, and nothing below it mentions IO.
view :: Str -> a -> <IO> a
view f dflt = do
  r <- @load f
  match r | (Ok x) = x | (Err _) = dflt

--' Read the file, apply a pure transformation, write it back, return it.
--' The only function in the module that writes to disk.
edit :: Str -> a -> (a -> a) -> <IO> a
edit f dflt g = do
  old <- view f dflt
  let new = g old
  @savej f new
  new


-- ------------------------------------------------------------ pure core

--' Append one task
push :: Str -> Int -> [Todo] -> [Todo]
push title p ts = snoc ts { title = title, priority = p, done = False }

--' Apply `g` to the element at `i`, if there is one
atIndex :: Int -> (a -> a) -> [a] -> [a]
atIndex i g xs
  ? i < 0 = xs
  ? i >= length xs = xs
  : .[0:i] xs <> [g (.[i] xs)] <> .[i+1:] xs

--' Flip a task's done flag
flipDone :: Todo -> Todo
flipDone t = .(.done = not (.done t)) t

--' Remove the element at `i`, if there is one
without :: Int -> [a] -> [a]
without i xs
  ? i < 0 = xs
  ? i >= length xs = xs
  : .[0:i] xs <> .[i+1:] xs

--' Keep only the unfinished tasks
undone :: [Todo] -> [Todo]
undone = filter (\t -> not (.done t))

--' Highest priority first, stably
byPriority :: [Todo] -> [Todo]
byPriority = sortBy (\a b -> .priority a >= .priority b)


-- ------------------------------------------------------------ presentation

--' Draw the list as a checklist
draw :: [Todo] -> Str
draw ts
  ? length ts == 0 = "(nothing to do)\n"
  : rows 0 ts
  where
    rows :: Int -> [Todo] -> Str
    rows i ts
      ? length ts == 0 = ""
      : line i (.[0] ts) <> rows (i + 1) (.[1:] ts)

    line :: Int -> Todo -> Str
    line i t = show i <> " " <> box t <> " " <> bar t <> " " <> .title t <> "\n"

    box :: Todo -> Str
    box t ? .done t = "[x]"
           : "[ ]"

    bar :: Todo -> Str
    bar t
      ? .priority t >= 3 = "!!!"
      ? .priority t == 2 = "!! "
      :                    "!  "


-- ------------------------------------------------------------ commands

--' Add a task
--' @render -d/--draw=draw @default
add ::
  TodoFile ->
  --' what to do
  --' @metavar TITLE
  Str ->
  --' priority, 1 (low) to 3 (high)
  --' @arg -p/--priority
  --' @default 1
  Int ->
  <IO> [Todo]
add f title p = edit f [] (push title p)

--' Toggle the done flag of one task
--' @render -d/--draw=draw @default
check ::
  TodoFile ->
  --' index of the task, as shown by `list`
  --' @metavar INDEX
  Int ->
  <IO> [Todo]
check f i = edit f [] (atIndex i flipDone)

--' Remove one task
--' @render -d/--draw=draw @default
drop ::
  TodoFile ->
  --' index of the task, as shown by `list`
  --' @metavar INDEX
  Int ->
  <IO> [Todo]
drop f i = edit f [] (without i)

--' Drop every completed task
--' @render -d/--draw=draw @default
clean :: TodoFile -> <IO> [Todo]
clean f = edit f [] undone

--' Reorder the list, highest priority first
--' @render -d/--draw=draw @default
sort :: TodoFile -> <IO> [Todo]
sort f = edit f [] byPriority

--' Show the task list; unlike the others this never writes
--' @render -d/--draw=draw @default
list :: TodoFile -> <IO> [Todo]
list f = view f []
