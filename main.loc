--' A TODO list: one functional core behind a CLI, a TUI and a web app
--'
--' Every command is `edit f <a pure [Todo] -> [Todo] function>`. The
--' only IO in the module is inside `edit`; everything else is a pure
--' list transformation that can be read, tested and composed on its own.
--'
--' The same core is handed to two hosts as a record of functions: a Rust
--' terminal interface (`tui`) and a Python web application (`app`).
--' Neither host knows where the list lives or how it is stored.
--'
--\ Two interface notes:
--\   * `--' @name title` is how a positional gets a name a caller can
--\     use. Every machine-readable view agrees on it; without one they
--\     agree on `_1`, since a metavar names a type and repeats.
--\   * the tag list is `--' @arg -t/--tag` rather than a bare `@many`
--\     positional: a `@many` positional cannot be empty and cannot be
--\     given a default.
module demo-todo (add, check, drop, clean, sort, list, tui, app)

import root-py
import root-rust

--' Path to the TODO file
--' @default "todo.json"
--' @arg -F/--file
--' @check.path w
type TodoFile = Str

--' A single task
record Todo where
  --' item title
  title :: Str
  --' priority, 1 (low) to 3 (high)
  priority :: Int
  --' whether the task is complete
  done :: Bool
  --' free-form labels
  tags :: [Str]

--' Everything optional about a new task
--' @unroll true
record NewOpts where
  --' priority, 1 (low) to 3 (high)
  --' @arg -p/--priority
  --' @default 1
  priority :: Int

  --' start the task already checked off
  --' @true -x/--done
  done :: Bool

--' How to select which tasks to show
--' @unroll true
record Filter where
  --' hide tasks that are already done
  --' @true -u/--unfinished
  unfinished :: Bool

  --' show only tasks at or above this priority
  --' @arg -m/--min-priority
  --' @default 0
  minPriority :: Int

--' Where the web app listens
--' @unroll true
record Serve where
  --' TCP port
  --' @arg -p/--port
  --' @default 8000
  port :: Int

  --' listen on every interface (0.0.0.0) rather than loopback only
  --' @true -P/--public
  public :: Bool

--' The core as a host sees it: every operation over one stored list.
--' A field with no arguments is a suspension; the host runs it once per
--' use, so `list` always reads the file as it is now.
record Api where
  list  :: <IO> [Todo]
  add   :: Str -> Int -> [Str] -> <IO> [Todo]
  check :: Int -> <IO> [Todo]
  drop  :: Int -> <IO> [Todo]
  clean :: <IO> [Todo]
  sort  :: <IO> [Todo]

record py => Todo = "dict"
record py => NewOpts = "dict"
record py => Filter = "dict"
record py => Serve = "dict"
record py => Api = "dict"

record Rust => Todo = "Todo"
record Rust => NewOpts = "struct"
record Rust => Filter = "struct"
record Rust => Serve = "struct"
record Rust => Api = "Api"

source Rust from "tui.rs" ("todo_tui" as runTui)
source Py from "app.py" ("todo_app" as runApp)

--' Run the terminal interface over the given operations
runTui :: Api -> <IO> Str

--' Serve the web application over the given operations
runApp :: Api -> Str -> Int -> <IO> Str


-- ------------------------------------------------------------- storage

--' Read a JSON file, or `dflt` if it is not there.
--'
--\ Fully polymorphic: `a` is fixed by the call site. This is the whole
--\ persistence layer, and nothing below it mentions IO.
view :: Str -> a -> <IO> a
view f dflt = do
  r <- @load f
  match r | (Ok x) = x | (Err _) = dflt

--' Read the file, apply a pure transformation, write it back, return it.
--' The only function in the module that writes to disk.
edit :: Str -> a -> (a -> a) -> <IO> a
edit f dflt g = do
  old <- view f dflt
  let new = g old
  @savej f new
  new


-- ------------------------------------------------------------ pure core

--' Append one task
push :: Str -> [Str] -> NewOpts -> [Todo] -> [Todo]
push title tags o ts =
  snoc ts { title = title, priority = .priority o, done = .done o, tags = tags }

--' Apply `g` to the element at `i`, if there is one
atIndex :: Int -> (a -> a) -> [a] -> [a]
atIndex i g xs
  ? i < 0 = xs
  ? i >= length xs = xs
  : .[0:i] xs <> [g (.[i] xs)] <> .[i+1:] xs

--' Flip a task's done flag
flipDone :: Todo -> Todo
flipDone t = .(.done = not (.done t)) t

--' Remove the element at `i`, if there is one
without :: Int -> [a] -> [a]
without i xs
  ? i < 0 = xs
  ? i >= length xs = xs
  : .[0:i] xs <> .[i+1:] xs

--' Keep only the unfinished tasks
undone :: [Todo] -> [Todo]
undone = filter (\t -> not (.done t))

--' Highest priority first, stably
byPriority :: [Todo] -> [Todo]
byPriority = sortBy (\a b -> .priority a > .priority b)

--' Keep the tasks a filter selects
select :: Filter -> [Todo] -> [Todo]
select q = filter keep
  where
    keep :: Todo -> Bool
    keep t = wanted t && .priority t >= .minPriority q

    wanted :: Todo -> Bool
    wanted t ? .unfinished q = not (.done t)
             : True


-- ------------------------------------------------------------ renderers

--' Draw the list as a checklist
draw :: [Todo] -> Str
draw ts
  ? length ts == 0 = "(nothing to do)\n"
  : rows 0 ts
  where
    rows :: Int -> [Todo] -> Str
    rows i ts
      ? length ts == 0 = ""
      : line i (.[0] ts) <> rows (i + 1) (.[1:] ts)

    line :: Int -> Todo -> Str
    line i t =
      show i <> " " <> box t <> " " <> bar t <> " " <> .title t
        <> labels (.tags t) <> "\n"

    box :: Todo -> Str
    box t ? .done t = "[x]"
           : "[ ]"

    bar :: Todo -> Str
    bar t
      ? .priority t >= 3 = "!!!"
      ? .priority t == 2 = "!! "
      :                    "!  "

    labels :: [Str] -> Str
    labels xs
      ? length xs == 0 = ""
      : "  #" <> joinWith "  #" xs

    joinWith :: Str -> [Str] -> Str
    joinWith sep xs
      ? length xs <= 1 = fold (<>) "" xs
      : .[0] xs <> sep <> joinWith sep (.[1:] xs)


--' Render the list as a Markdown task list
markdown :: [Todo] -> Str
markdown ts
  ? length ts == 0 = "_nothing to do_\n"
  : rows ts
  where
    rows :: [Todo] -> Str
    rows ts
      ? length ts == 0 = ""
      : line (.[0] ts) <> rows (.[1:] ts)

    line :: Todo -> Str
    line t = "- [" <> mark t <> "] " <> .title t <> "\n"

    mark :: Todo -> Str
    mark t ? .done t = "x"
            : " "


--' Report how many tasks are left
remaining :: [Todo] -> Int
remaining = length . undone


-- ------------------------------------------------------------ commands

--' Add a task
--' @render -d/--draw=draw @default
--' @render -k/--markdown=markdown
--' @with   -n/--count=remaining
add ::
  TodoFile ->
  --' what to do
  --' @name title
  --' @metavar TITLE
  Str ->
  --' labels to attach to the task
  --' @arg -t/--tag
  --' @many
  --' @default []
  --' @metavar TAG
  [Str] ->
  NewOpts ->
  <IO> [Todo]
add f title tags o = edit f [] (push title tags o)

--' Toggle the done flag of one task
--' @render -d/--draw=draw @default
--' @render -k/--markdown=markdown
--' @with   -n/--count=remaining
check ::
  TodoFile ->
  --' index of the task, as shown by `list`
  --' @name index
  --' @metavar INDEX
  Int ->
  <IO> [Todo]
check f i = edit f [] (atIndex i flipDone)

--' Remove one task
--' @render -d/--draw=draw @default
--' @render -k/--markdown=markdown
drop ::
  TodoFile ->
  --' index of the task, as shown by `list`
  --' @name index
  --' @metavar INDEX
  Int ->
  <IO> [Todo]
drop f i = edit f [] (without i)

--' Drop every completed task
--' @render -d/--draw=draw @default
--' @render -k/--markdown=markdown
clean :: TodoFile -> <IO> [Todo]
clean f = edit f [] undone

--' Reorder the list, highest priority first
--' @render -d/--draw=draw @default
--' @render -k/--markdown=markdown
sort :: TodoFile -> <IO> [Todo]
sort f = edit f [] byPriority

--' Show the task list; unlike the others this never writes
--' @render -d/--draw=draw @default
--' @render -k/--markdown=markdown
--' @with   -n/--count=remaining
list :: TodoFile -> Filter -> <IO> [Todo]
list f q = do
  ts <- view f []
  select q ts


-- --------------------------------------------------------------- hosts

--' The core over one file, as a record a host can call
api :: TodoFile -> Api
api f =
  { list  = view f []
  , add   = \title p tags -> edit f [] (push title tags { priority = p, done = False })
  , check = \i -> edit f [] (atIndex i flipDone)
  , drop  = \i -> edit f [] (without i)
  , clean = edit f [] undone
  , sort  = edit f [] byPriority
  }

--' Open the list in a terminal interface
--'
--\ The interface is Rust (ratatui); the list it edits is the same file
--\ the other commands use, through the same functions.
tui :: TodoFile -> <IO> Str
tui f = runTui (api f)

--' Serve the list as a web application
--'
--\ The server is Python (FastAPI on uvicorn). It listens on loopback
--\ unless `--public` is given; stop it with Ctrl-C.
app :: TodoFile -> Serve -> <IO> Str
app f s = runApp (api f) (bind (.public s)) (.port s)
  where
    bind :: Bool -> Str
    bind public ? public = "0.0.0.0"
                : "127.0.0.1"
